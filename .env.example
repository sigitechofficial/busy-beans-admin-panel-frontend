# Copy to .env.local (dev) or set in the hosting environment. Never commit real values.

# Preset in src/utilities/URL.js: local | staging | aws | production (default: staging).
# Local dev: NEXT_PUBLIC_APP_ENV=local. Production hosting: NEXT_PUBLIC_APP_ENV=production.
NEXT_PUBLIC_APP_ENV=local

# Server-only (no NEXT_PUBLIC_ prefix): used by src/app/api/captcha/route.js to call Google siteverify.
RECAPTCHA_SECRET_KEY=

# Optional: overrides CAMPAIGN_BUILDER_URL from src/utilities/URL.js
# NEXT_PUBLIC_CAMPAIGN_BUILDER_URL=
